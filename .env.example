# ── Next.js (public) ──
NEXT_PUBLIC_SITE_URL=https://psalmnova.vercel.app
NEXT_PUBLIC_GITHUB_USER=kaptainpsalmy
NEXT_PUBLIC_SENTRY_DSN=      # Sentry project for the website (Next.js); errors are off when empty

# ── Sentry source maps (build only, keep secret) ──
SENTRY_AUTH_TOKEN=           # organization auth token; without it the build skips the upload
SENTRY_ORG=
SENTRY_PROJECT=              # the website project's slug

# ── FastAPI (server-only): all optional, endpoints degrade gracefully ──
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=          # optional: embeddings for richer RAG retrieval
GROQ_API_KEY=                # RAG chat answer generation (Groq, OpenAI-compatible)
SENTRY_DSN=                  # Sentry project for the API (Python / FastAPI)
CONTACT_TO_EMAIL=kaptainpsalmy@gmail.com
